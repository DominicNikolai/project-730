---
import { baseUrl } from '@/utils/functions';

const defaultImage = baseUrl('/assets/villi.jpg');
---

<div id='ui-overlay'></div>
<input type='file' id='file-input' accept='image/*' />
<div id='canvas-container' data-image={defaultImage}></div>

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: #111;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  #canvas-container {
    width: 100%;
    height: 100%;
    display: block;
  }

  #file-input {
    display: none;
  }
</style>

<script>
  import GUI from 'lil-gui';
  import {
    AdditiveBlending,
    BufferAttribute,
    BufferGeometry,
    Group,
    LineSegments,
    Mesh,
    MeshBasicMaterial,
    PerspectiveCamera,
    PlaneGeometry,
    Raycaster,
    Scene,
    ShaderMaterial,
    Texture,
    Timer,
    Vector2,
    Vector3,
    WebGLRenderer
  } from 'three';

  const noiseChunk = `
    vec3 mod289(vec3 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec4 mod289(vec4 x) { return x - floor(x * (1.0 / 289.0)) * 289.0; }
    vec4 permute(vec4 x) { return mod289(((x*34.0)+1.0)*x); }
    vec4 taylorInvSqrt(vec4 r) { return 1.79284291400159 - 0.85373472095314 * r; }
    float snoise(vec3 v) {
      const vec2  C = vec2(1.0/6.0, 1.0/3.0) ;
      const vec4  D = vec4(0.0, 0.5, 1.0, 2.0);
      vec3 i  = floor(v + dot(v, C.yyy) );
      vec3 x0 = v - i + dot(i, C.xxx) ;
      vec3 g = step(x0.yzx, x0.xyz);
      vec3 l = 1.0 - g;
      vec3 i1 = min( g.xyz, l.zxy );
      vec3 i2 = max( g.xyz, l.zxy );
      vec3 x1 = x0 - i1 + C.xxx;
      vec3 x2 = x0 - i2 + C.yyy;
      vec3 x3 = x0 - D.yyy;
      i = mod289(i);
      vec4 p = permute( permute( permute(
              i.z + vec4(0.0, i1.z, i2.z, 1.0 ))
            + i.y + vec4(0.0, i1.y, i2.y, 1.0 ))
            + i.x + vec4(0.0, i1.x, i2.x, 1.0 ));
      float n_ = 0.142857142857;
      vec3  ns = n_ * D.wyz - D.xzx;
      vec4 j = p - 49.0 * floor(p * ns.z * ns.z);
      vec4 x_ = floor(j * ns.z);
      vec4 y_ = floor(j - 7.0 * x_ );
      vec4 x = x_ *ns.x + ns.yyyy;
      vec4 y = y_ *ns.x + ns.yyyy;
      vec4 h = 1.0 - abs(x) - abs(y);
      vec4 b0 = vec4( x.xy, y.xy );
      vec4 b1 = vec4( x.zw, y.zw );
      vec4 s0 = floor(b0)*2.0 + 1.0;
      vec4 s1 = floor(b1)*2.0 + 1.0;
      vec4 sh = -step(h, vec4(0.0));
      vec4 a0 = b0.xzyw + s0.xzyw*sh.xxyy ;
      vec4 a1 = b1.xzyw + s1.xzyw*sh.zzww ;
      vec3 p0 = vec3(a0.xy,h.x);
      vec3 p1 = vec3(a0.zw,h.y);
      vec3 p2 = vec3(a1.xy,h.z);
      vec3 p3 = vec3(a1.zw,h.w);
      vec4 norm = taylorInvSqrt(vec4(dot(p0,p0), dot(p1,p1), dot(p2, p2), dot(p3,p3)));
      p0 *= norm.x;
      p1 *= norm.y;
      p2 *= norm.z;
      p3 *= norm.w;
      vec4 m = max(0.6 - vec4(dot(x0,x0), dot(x1,x1), dot(x2,x2), dot(x3,x3)), 0.0);
      m = m * m;
      return 42.0 * dot( m*m, vec4( dot(p0,x0), dot(p1,x1), dot(p2,x2), dot(p3,x3) ) );
    }
  `;

  const hairVertexShader = `
    uniform float uTime;
    uniform float uMinBrightness;
    uniform float uMaxBrightness;
    uniform float uHairLength;
    uniform float uWindForce;
    uniform float uNoiseFreq;
    uniform float uNoiseSpeed;
    uniform vec3 uMouseWorld;
    uniform float uMouseRadius;
    uniform float uMouseForce;

    attribute float aProgress;
    attribute float aBrightness;
    attribute vec3 aColor;

    varying vec3 vColor;

    ${noiseChunk}

    void main() {
      if (aBrightness < uMinBrightness || aBrightness > uMaxBrightness) {
        gl_Position = vec4(2.0, 2.0, 2.0, 1.0);
        return;
      }

      vec3 pos = position;

      vec3 noisePos = vec3(pos.xy * uNoiseFreq, uTime * uNoiseSpeed);
      float nX = snoise(noisePos);
      float nY = snoise(noisePos + vec3(100.0));

      float bendFactor = pow(aProgress, 1.5);

      pos.x += nX * uWindForce * bendFactor * uHairLength;
      pos.y += nY * uWindForce * bendFactor * uHairLength;

      pos.z += aProgress * uHairLength;

      vec4 worldPos = modelMatrix * vec4(pos, 1.0);

      vec2 mouseDir = uMouseWorld.xy - worldPos.xy;
      float distToMouse = length(mouseDir);
      float attraction = smoothstep(uMouseRadius, 0.0, distToMouse);

      worldPos.xy += mouseDir * attraction * uMouseForce * aProgress * uHairLength;

      gl_Position = projectionMatrix * viewMatrix * worldPos;

      float shading = mix(0.2, 1.2, aProgress);
      vColor = aColor * shading;
    }
  `;

  const hairFragmentShader = `
    varying vec3 vColor;
    void main() {
      gl_FragColor = vec4(vColor, 1.0);
    }
  `;

  type HairMesh = LineSegments<BufferGeometry, ShaderMaterial>;
  type BackgroundPlane = Mesh<PlaneGeometry, MeshBasicMaterial>;

  let scene: Scene;
  let camera: PerspectiveCamera;
  let renderer: WebGLRenderer;
  let hairMesh: HairMesh | null = null;
  let bgPlane: BackgroundPlane | null = null;
  let hairMaterial: ShaderMaterial | null = null;
  let currentTexture: Texture | null = null;
  let gui: GUI;
  let fileInput: HTMLInputElement;

  const group = new Group();
  const timer = new Timer();
  const raycaster = new Raycaster();
  const mouse = new Vector2(-999, -999);
  const targetMouseWorld = new Vector3(9999, 9999, 9999);

  let imageAspect = 1;
  let mouseX = 0;
  let mouseY = 0;
  let targetX = 0;
  let targetY = 0;

  const params = {
    imageUrl: '',
    minBrightness: 0.0,
    maxBrightness: 1.0,
    hairLength: 0.529,
    windForce: 0.0705,
    noiseFreq: 2.242,
    noiseSpeed: 0.188,
    mouseRadius: 2.9403,
    mouseForce: 0.234,
    uploadNew: () => fileInput.click()
  };

  function init() {
    const container = document.getElementById('canvas-container');
    const input = document.getElementById('file-input');

    if (!container || !input) return;
    fileInput = input as HTMLInputElement;

    scene = new Scene();
    scene.add(group);

    camera = new PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 10;

    renderer = new WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    gui = new GUI({ title: 'Effect Settings' });
    gui.hide();

    window.addEventListener('resize', onWindowResize);
    document.addEventListener('mousemove', onMouseMove);
    fileInput.addEventListener('change', handleFileUpload);

    animate();

    params.imageUrl = container.dataset.image ?? '';
    if (params.imageUrl) loadImageFromUrl(params.imageUrl);
  }

  function processImage(imageObj: HTMLImageElement) {
    if (hairMesh) {
      group.remove(hairMesh);
      hairMesh.geometry.dispose();
    }
    if (bgPlane) {
      group.remove(bgPlane);
      bgPlane.geometry.dispose();
      bgPlane.material.dispose();
    }
    if (currentTexture) {
      currentTexture.dispose();
    }

    currentTexture = new Texture(imageObj);
    currentTexture.needsUpdate = true;
    imageAspect = imageObj.width / imageObj.height;

    const MAX_GRID = 200;
    let gridW = imageObj.width;
    let gridH = imageObj.height;

    if (gridW > gridH && gridW > MAX_GRID) {
      gridH = Math.floor(MAX_GRID * gridH / gridW);
      gridW = MAX_GRID;
    } else if (gridH > MAX_GRID) {
      gridW = Math.floor(MAX_GRID * gridW / gridH);
      gridH = MAX_GRID;
    }

    const canvas = document.createElement('canvas');
    canvas.width = gridW;
    canvas.height = gridH;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    ctx.drawImage(imageObj, 0, 0, gridW, gridH);
    const imgData = ctx.getImageData(0, 0, gridW, gridH).data;

    const segmentsPerHair = 4;
    const verticesPerHair = segmentsPerHair * 2;
    const totalHairs = gridW * gridH;
    const totalVertices = totalHairs * verticesPerHair;

    const positions = new Float32Array(totalVertices * 3);
    const progresses = new Float32Array(totalVertices);
    const brightnesses = new Float32Array(totalVertices);
    const colors = new Float32Array(totalVertices * 3);

    let vIdx = 0;

    for (let y = 0; y < gridH; y++) {
      for (let x = 0; x < gridW; x++) {
        const pxIdx = (y * gridW + x) * 4;
        const r = imgData[pxIdx] / 255;
        const g = imgData[pxIdx + 1] / 255;
        const b = imgData[pxIdx + 2] / 255;

        const brightness = r * 0.299 + g * 0.587 + b * 0.114;

        const nx = x / gridW - 0.5;
        const ny = -(y / gridH) + 0.5;

        for (let s = 0; s < segmentsPerHair; s++) {
          const p1 = s / segmentsPerHair;
          const p2 = (s + 1) / segmentsPerHair;

          positions[vIdx * 3] = nx;
          positions[vIdx * 3 + 1] = ny;
          positions[vIdx * 3 + 2] = 0;
          progresses[vIdx] = p1;
          brightnesses[vIdx] = brightness;
          colors[vIdx * 3] = r;
          colors[vIdx * 3 + 1] = g;
          colors[vIdx * 3 + 2] = b;
          vIdx++;

          positions[vIdx * 3] = nx;
          positions[vIdx * 3 + 1] = ny;
          positions[vIdx * 3 + 2] = 0;
          progresses[vIdx] = p2;
          brightnesses[vIdx] = brightness;
          colors[vIdx * 3] = r;
          colors[vIdx * 3 + 1] = g;
          colors[vIdx * 3 + 2] = b;
          vIdx++;
        }
      }
    }

    const geometry = new BufferGeometry();
    geometry.setAttribute('position', new BufferAttribute(positions, 3));
    geometry.setAttribute('aProgress', new BufferAttribute(progresses, 1));
    geometry.setAttribute('aBrightness', new BufferAttribute(brightnesses, 1));
    geometry.setAttribute('aColor', new BufferAttribute(colors, 3));

    hairMaterial = new ShaderMaterial({
      vertexShader: hairVertexShader,
      fragmentShader: hairFragmentShader,
      transparent: true,
      depthWrite: false,
      blending: AdditiveBlending,
      uniforms: {
        uTime: { value: 0 },
        uMinBrightness: { value: params.minBrightness },
        uMaxBrightness: { value: params.maxBrightness },
        uHairLength: { value: params.hairLength },
        uWindForce: { value: params.windForce },
        uNoiseFreq: { value: params.noiseFreq },
        uNoiseSpeed: { value: params.noiseSpeed },
        uMouseWorld: { value: new Vector3(9999, 9999, 9999) },
        uMouseRadius: { value: params.mouseRadius },
        uMouseForce: { value: params.mouseForce }
      }
    });

    hairMesh = new LineSegments(geometry, hairMaterial);

    const planeGeo = new PlaneGeometry(1, 1);
    const planeMat = new MeshBasicMaterial({
      map: currentTexture,
      color: 0xffffff
    });
    bgPlane = new Mesh(planeGeo, planeMat);
    bgPlane.position.z = -0.01;

    group.add(bgPlane);
    group.add(hairMesh);

    updateCoverScale();
    setupGUI();

    const overlay = document.getElementById('ui-overlay');
    if (overlay) {
      overlay.style.opacity = '0';
      setTimeout(() => {
        overlay.style.display = 'none';
        gui.show();
      }, 500);
    }
  }

  function updateCoverScale() {
    if (!bgPlane || !hairMesh) return;

    const windowAspect = window.innerWidth / window.innerHeight;

    const fov = camera.fov * (Math.PI / 180);
    const visibleHeight = 2 * Math.tan(fov / 2) * camera.position.z;
    const visibleWidth = visibleHeight * windowAspect;

    let scaleX: number;
    let scaleY: number;

    if (windowAspect > imageAspect) {
      scaleX = visibleWidth;
      scaleY = visibleWidth / imageAspect;
    } else {
      scaleY = visibleHeight;
      scaleX = visibleHeight * imageAspect;
    }

    bgPlane.scale.set(scaleX, scaleY, 1);
    hairMesh.scale.set(scaleX, scaleY, 1);
  }

  function onWindowResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    updateCoverScale();
  }

  function onMouseMove(event: MouseEvent) {
    mouseX = event.clientX / window.innerWidth * 2 - 1;
    mouseY = -(event.clientY / window.innerHeight) * 2 + 1;

    mouse.x = mouseX;
    mouse.y = mouseY;
  }

  function handleFileUpload(event: Event) {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => processImage(img);
      img.src = reader.result as string;
    };
    reader.readAsDataURL(file);

    input.value = '';
  }

  function loadImageFromUrl(url: string) {
    const img = new Image();
    img.crossOrigin = 'Anonymous';
    img.onload = () => processImage(img);
    img.onerror = () => {
      console.error('Failed to load image from URL. It might be blocked by CORS.');
    };
    img.src = url;
  }

  function setupGUI() {
    if (gui.controllers.length > 0 || !hairMaterial) return;
    const material = hairMaterial;

    gui.add(params, 'imageUrl').name('Image URL').onFinishChange((v: string) => loadImageFromUrl(v));
    gui.add(params, 'minBrightness', 0.0, 1.0).name('Min Brightness').onChange((v: number) => material.uniforms.uMinBrightness.value = v);
    gui.add(params, 'maxBrightness', 0.0, 1.0).name('Max Brightness').onChange((v: number) => material.uniforms.uMaxBrightness.value = v);
    gui.add(params, 'hairLength', 0.0, 3.0, 0.001).name('Villi Length').onChange((v: number) => material.uniforms.uHairLength.value = v);
    gui.add(params, 'windForce', 0.0, 0.1).name('Wind Force').onChange((v: number) => material.uniforms.uWindForce.value = v);
    gui.add(params, 'noiseFreq', 1.0, 3.5).name('Noise Detail').onChange((v: number) => material.uniforms.uNoiseFreq.value = v);
    gui.add(params, 'noiseSpeed', 0.0, 0.5).name('Animation Speed').onChange((v: number) => material.uniforms.uNoiseSpeed.value = v);
    gui.add(params, 'mouseRadius', 0.1, 10.0).name('Mouse Radius').onChange((v: number) => material.uniforms.uMouseRadius.value = v);
    gui.add(params, 'mouseForce', 0.0, 1.0).name('Mouse Force').onChange((v: number) => material.uniforms.uMouseForce.value = v);
    gui.add(params, 'uploadNew').name('Upload New Image');
  }

  function animate() {
    requestAnimationFrame(animate);

    targetX = mouseX * 0.1;
    targetY = mouseY * 0.1;
    group.rotation.y += (targetX - group.rotation.y) * 0.05;
    group.rotation.x += (-targetY - group.rotation.x) * 0.05;

    if (hairMaterial && bgPlane) {
      timer.update();
      hairMaterial.uniforms.uTime.value = timer.getElapsed();

      raycaster.setFromCamera(mouse, camera);
      const intersects = raycaster.intersectObject(bgPlane);

      if (intersects.length > 0) {
        targetMouseWorld.copy(intersects[0].point);
      } else {
        targetMouseWorld.set(9999, 9999, 9999);
      }

      hairMaterial.uniforms.uMouseWorld.value.lerp(targetMouseWorld, 0.08);
    }

    renderer.render(scene, camera);
  }

  init();
</script>
